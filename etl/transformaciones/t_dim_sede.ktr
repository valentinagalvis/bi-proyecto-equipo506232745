<step><name>Leer F1 ventas POS (csv)</name><type>CsvInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><filename>${Internal.Entry.Current.Directory}/../../datos/raw/ventas_pos.csv</filename><filename_field/><rownum_field/><include_filename>N</include_filename><separator>,</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><lazy_conversion>N</lazy_conversion><add_filename_result>N</add_filename_result><parallel>N</parallel><newline_possible>N</newline_possible><encoding>UTF-8</encoding><fields><field><name>id_venta</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>fecha</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>id_sede</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>ciudad</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>id_producto</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>categoria</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>unidades</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>precio_unitario</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>costo_unitario</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>id_cliente</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>canal</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field></fields><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>250</xloc><yloc>220</yloc><draw>Y</draw></GUI></step>
<step><name>normaliza_ciudad</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script 1</jsScript_name><jsScript_script>
var MESES = {ene:'01',jan:'01',feb:'02',mar:'03',abr:'04',apr:'04',may:'05',jun:'06',jul:'07',ago:'08',aug:'08',sep:'09',oct:'10',nov:'11',dic:'12',dec:'12'};
function pad2(x){ x = '' + x; return x.length &lt; 2 ? '0' + x : x; }
// Devuelve 'aaaa-mm-dd' a partir de aaaa-mm-dd, aaaa/mm/dd, dd/mm/aaaa o dd-mmm-aa; null si no reconoce el formato
function normalizaFecha(s){
  if (s == null) return null;
  s = ('' + s).trim();
  var m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
  if (m) return m[1] + '-' + pad2(m[2]) + '-' + pad2(m[3]);
  m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if (m) return m[3] + '-' + pad2(m[2]) + '-' + pad2(m[1]);
  m = s.match(/^(\d{1,2})-([A-Za-z]{3})\.?-(\d{2})$/);
  if (m &amp;&amp; MESES[m[2].toLowerCase()]) return '20' + m[3] + '-' + MESES[m[2].toLowerCase()] + '-' + pad2(m[1]);
  return null;
}
// Convierte '$ 20.640', '13.796,00', '39510.0' o '3073' a número; null si está vacío
function aNumero(s){
  if (s == null) return null;
  s = ('' + s).trim();
  if (s == '') return null;
  if (s.indexOf('$') &gt;= 0 || s.indexOf(',') &gt;= 0) {
    s = s.replace(/\$/g, '').replace(/\s/g, '').replace(/\./g, '').replace(',', '.');
  }
  var n = parseFloat(s);
  return isNaN(n) ? null : n;
}
function capitaliza(s){
  if (s == null) return null;
  s = ('' + s).trim().toLowerCase();
  return s.charAt(0).toUpperCase() + s.substring(1);
}
ciudad = capitaliza(ciudad);</jsScript_script></jsScript></jsScripts><fields><field><name>ciudad</name><rename>ciudad</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field></fields><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>420</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>
<step><name>sedes_distintas</name><type>UniqueRowsByHashSet</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><store_values>N</store_values><reject_duplicate_row>N</reject_duplicate_row><error_description/><fields><field><name>id_sede</name></field></fields><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>590</xloc><yloc>220</yloc><draw>Y</draw></GUI></step>
<step><name>deriva_nombre_y_region</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script 1</jsScript_name><jsScript_script>
var MESES = {ene:'01',jan:'01',feb:'02',mar:'03',abr:'04',apr:'04',may:'05',jun:'06',jul:'07',ago:'08',aug:'08',sep:'09',oct:'10',nov:'11',dic:'12',dec:'12'};
function pad2(x){ x = '' + x; return x.length &lt; 2 ? '0' + x : x; }
// Devuelve 'aaaa-mm-dd' a partir de aaaa-mm-dd, aaaa/mm/dd, dd/mm/aaaa o dd-mmm-aa; null si no reconoce el formato
function normalizaFecha(s){
  if (s == null) return null;
  s = ('' + s).trim();
  var m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
  if (m) return m[1] + '-' + pad2(m[2]) + '-' + pad2(m[3]);
  m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if (m) return m[3] + '-' + pad2(m[2]) + '-' + pad2(m[1]);
  m = s.match(/^(\d{1,2})-([A-Za-z]{3})\.?-(\d{2})$/);
  if (m &amp;&amp; MESES[m[2].toLowerCase()]) return '20' + m[3] + '-' + MESES[m[2].toLowerCase()] + '-' + pad2(m[1]);
  return null;
}
// Convierte '$ 20.640', '13.796,00', '39510.0' o '3073' a número; null si está vacío
function aNumero(s){
  if (s == null) return null;
  s = ('' + s).trim();
  if (s == '') return null;
  if (s.indexOf('$') &gt;= 0 || s.indexOf(',') &gt;= 0) {
    s = s.replace(/\$/g, '').replace(/\s/g, '').replace(/\./g, '').replace(',', '.');
  }
  var n = parseFloat(s);
  return isNaN(n) ? null : n;
}
function capitaliza(s){
  if (s == null) return null;
  s = ('' + s).trim().toLowerCase();
  return s.charAt(0).toUpperCase() + s.substring(1);
}
var nombre_sede = 'Alianza ' + ciudad;
var REG = {'Bogotá':'Andina','Medellín':'Andina','Cali':'Pacífica','Barranquilla':'Caribe'};
var region = REG[ciudad] ? REG[ciudad] : 'Sin región';</jsScript_script></jsScript></jsScripts><fields><field><name>nombre_sede</name><rename>nombre_sede</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>region</name><rename>region</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>760</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>
<step><name>Escribir dim_sede</name><type>TableOutput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>dw_alianza</connection><schema/><table>dim_sede</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields><field><column_name>id_sede</column_name><stream_name>id_sede</stream_name></field><field><column_name>nombre_sede</column_name><stream_name>nombre_sede</stream_name></field><field><column_name>ciudad</column_name><stream_name>ciudad</stream_name></field><field><column_name>region</column_name><stream_name>region</stream_name></field></fields><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>930</xloc><yloc>220</yloc><draw>Y</draw></GUI></step>

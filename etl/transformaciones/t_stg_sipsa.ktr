}
var grupo_ok = Grupo == null ? null : ('' + Grupo).trim().toUpperCase();
var producto_ok = Producto == null ? null : ('' + Producto).trim().replace(/\s+/g, ' ');</jsScript_script></jsScript></jsScripts><fields><field><name>grupo_ok</name><rename>grupo_ok</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>producto_ok</name><rename>producto_ok</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>760</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>
<step><name>separa_ciudad_mercado</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script 1</jsScript_name><jsScript_script>
var MESES = {ene:'01',jan:'01',feb:'02',mar:'03',abr:'04',apr:'04',may:'05',jun:'06',jul:'07',ago:'08',aug:'08',sep:'09',oct:'10',nov:'11',dic:'12',dec:'12'};
function pad2(x){ x = '' + x; return x.length &lt; 2 ? '0' + x : x; }
// Devuelve 'aaaa-mm-dd' a partir de aaaa-mm-dd, aaaa/mm/dd, dd/mm/aaaa o dd-mmm-aa; null si no reconoce el formato
function normalizaFecha(s){
  if (s == null) return null;
  s = ('' + s).trim();
  var m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
  if (m) return m[1] + '-' + pad2(m[2]) + '-' + pad2(m[3]);
  m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if (m) return m[3] + '-' + pad2(m[2]) + '-' + pad2(m[1]);
  m = s.match(/^(\d{1,2})-([A-Za-z]{3})\.?-(\d{2})$/);
  if (m &amp;&amp; MESES[m[2].toLowerCase()]) return '20' + m[3] + '-' + MESES[m[2].toLowerCase()] + '-' + pad2(m[1]);
  return null;
}
// Convierte '$ 20.640', '13.796,00', '39510.0' o '3073' a número; null si está vacío
function aNumero(s){
  if (s == null) return null;
  s = ('' + s).trim();
  if (s == '') return null;
  if (s.indexOf('$') &gt;= 0 || s.indexOf(',') &gt;= 0) {
    s = s.replace(/\$/g, '').replace(/\s/g, '').replace(/\./g, '').replace(',', '.');
  }
  var n = parseFloat(s);
  return isNaN(n) ? null : n;
}
function capitaliza(s){
  if (s == null) return null;
  s = ('' + s).trim().toLowerCase();
  return s.charAt(0).toUpperCase() + s.substring(1);
}
var f = Fuente == null ? '' : ('' + Fuente).trim();
var ciudad = null, mercado = null;
var m = f.match(/^(.*?) \((.*?)\)(.*)$/);
if (m) { ciudad = m[1]; mercado = m[3].replace(/^,\s*/, '') || m[1]; }
else if (f.indexOf('Bogotá, D.C.') == 0 || f.toLowerCase().indexOf('bogotá, d.c.') == 0) { ciudad = 'Bogotá, D.C.'; mercado = f.substring(13).trim(); }
else { var i = f.indexOf(','); ciudad = i &gt; 0 ? f.substring(0, i) : f; mercado = i &gt; 0 ? f.substring(i + 1).trim() : f; }
ciudad = capitaliza(ciudad); if (ciudad != null &amp;&amp; ciudad.indexOf('Bogot') == 0) ciudad = 'Bogotá, D.C.';
if (mercado == null || mercado == '') mercado = ciudad;</jsScript_script></jsScript></jsScripts><fields><field><name>ciudad</name><rename>ciudad</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>mercado</name><rename>mercado</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>930</xloc><yloc>220</yloc><draw>Y</draw></GUI></step>
